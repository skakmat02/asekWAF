# Salin file ini menjadi .env lalu sesuaikan.
# Password default "admin" TIDAK aman dan akan ditampilkan sebagai peringatan di panel.

OPENWAF_ADMIN_PASSWORD=ganti-dengan-password-kuat
OPENWAF_SESSION_SECRET=ganti-dengan-string-acak-panjang
OPENWAF_COOKIE_SECURE=false

# UID/GID pemilik checkout project (jalankan `id -u` dan `id -g`).
# Diperlukan agar manager dapat memperbarui file konfigurasi pada Docker rootless.
OPENWAF_MANAGER_UID=1000
OPENWAF_MANAGER_GID=1000

# CIDR load balancer/reverse proxy yang dipercaya mengirim IP client asli.
# Jangan gunakan 0.0.0.0/0 karena client dapat memalsukan X-Forwarded-For.
OPENWAF_TRUSTED_PROXY=127.0.0.1
OPENWAF_REAL_IP_HEADER=X-Forwarded-For
OPENWAF_REAL_IP_RECURSIVE=on

# Pin versi image CRS untuk produksi, contoh:
# CRS_IMAGE=owasp/modsecurity-crs:4.25-nginx-lts
CRS_IMAGE=owasp/modsecurity-crs:nginx
