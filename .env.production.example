# Salin menjadi .env.production dan jangan commit file hasilnya.
# Gunakan: openssl rand -base64 36
OPENWAF_ADMIN_PASSWORD=GANTI-DENGAN-PASSWORD-UNIK-MINIMAL-16-KARAKTER
OPENWAF_SESSION_SECRET=GANTI-DENGAN-STRING-ACAK-MINIMAL-32-KARAKTER
OPENWAF_PRODUCTION=true
OPENWAF_COOKIE_SECURE=true

# Wajib berupa tag/digest stabil yang sudah diuji sebelum upgrade.
CRS_IMAGE=owasp/modsecurity-crs:4.25-nginx-lts
DOCKER_SOCKET_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy:v0.5.0

OPENWAF_TRUSTED_PROXY=127.0.0.1
OPENWAF_REAL_IP_HEADER=X-Forwarded-For
OPENWAF_REAL_IP_RECURSIVE=on
